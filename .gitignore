lib/I18n/I18nStrings.cpp
*.generated.h
# EXCEPTION: the web UI headers. scripts/build_html.py generates them, but the
# only thing that runs it is platformio.ini's `pre:` hook -- the from-source
# ESP-IDF path (tools/build.bat) has no generation step at all, so a fresh clone
# failed with "html/FilesPageHtml.generated.h: No such file or directory".
# They are derived from tracked .html/.js/.css/.svg sources, deterministic
# (byte-identical on regeneration), and small, so they are tracked here.
!src/network/html/**/*.generated.h
.vs
build
**/__pycache__/
/compile_commands.json
/.cache
